# ga4-mcp — every variable is OPTIONAL.
# Normal use needs none of them: run `ga4-mcp auth` once and the refresh token is stored in
# ~/.ga4-mcp/config.json (readable only by you). Never commit a real .env file.

# --- Credentials override (multi-account, CI, or when you do not want a config file) -------------
# If ALL THREE are set they are used instead of ~/.ga4-mcp/config.json.
# Client id/secret = a Google Cloud OAuth client of type "Desktop app".
# Refresh token    = obtained by `ga4-mcp auth` (copy it from config.json of the account you want).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Where config.json and audit.jsonl live (default: ~/.ga4-mcp) --------------------------------
# Use a different folder per Google account to switch accounts: GA4_MCP_CONFIG_DIR=~/.ga4-mcp-client-x
GA4_MCP_CONFIG_DIR=

# --- Local audit log of every tool call (default: enabled, ~/.ga4-mcp/audit.jsonl) ---------------
# Set to 1 to disable.
GA4_MCP_AUDIT_DISABLED=

# --- Log verbosity on stderr (DEBUG | INFO | WARNING). Logs never contain tokens or payloads. ------
MCP_LOG_LEVEL=INFO
